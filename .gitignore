名画库/**/*.tiff
名画库/**/*.webp
名画库/**/*.textClipping
# 打印稿成品(760 MB)不入库:由 画墙/脚本/gen_print_*.py 从原图重新生成
画墙/06_打印稿/**/*.jpg
画墙/06_打印稿/**/*.png
画墙/06_打印稿/**/*.pdf
画墙/06_打印稿/**/*.tif
